{
  "name": "ai-stocklens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "next build --webpack",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --conditions=react-server --test tests/*.test.ts",
    "test:components": "node --import tsx --test tests/components/*.test.tsx",
    "test:ollama": "node --conditions=react-server scripts/verify-ollama-regression.ts",
    "test:live": "node --use-system-ca --conditions=react-server --env-file=.env.local scripts/verify-live.ts",
    "test:phase2:live": "node --use-system-ca --conditions=react-server --env-file=.env.local scripts/verify-phase2.ts"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
