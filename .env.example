# Copy to .env.local. Never commit real keys.
FUYAO_API_KEY=

# Local run: leave the following optional variables commented out.
# Defining PUBLIC_ORIGIN as an empty value currently enables public configuration
# checks, so omit it entirely for localhost (do not use PUBLIC_ORIGIN=).
# Public HTTPS deployment: uncomment and use the actual canonical origin,
# without a trailing slash. This example is not a live URL.
# STOCKLENS_PUBLIC_ORIGIN=https://your-app.onrender.com
# STOCKLENS_PUBLIC_DEMO=1

# Per-process rolling 24h reservation budget, not the provider account quota.
STOCKLENS_MAX_UPSTREAM_CALLS_24H=140

# Optional supervised local Ollama experiment; keep off for public deployment.
# STOCKLENS_LOCAL_AI=1
